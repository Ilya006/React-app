{
  "name": "reactjs-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node server.dev.js",
    "prod": "npm run build && NODE_ENV=production node server.prod.js",
    "build": "npm run build:client && npm run build:server",
    "build:client-app": "vite build --emptyOutDir --outDir dist/client-app",
    "build:server-app": "vite build --emptyOutDir --outDir dist/server-app --ssr src/entry-server.tsx",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "cross-env NODE_ENV=production node server"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/express": "^5.0.0",
    "axios": "^1.7.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "node-cache": "^5.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.26.0",
    "sirv": "^3.0.1",
    "swiper": "^11.1.10",
    "tailwindcss": "^4.1.11",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@neodx/svg": "^0.7.1",
    "@types/node": "^22.4.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "sass": "^1.77.8",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vite-plugin-svgr": "^4.2.0"
  }
}
